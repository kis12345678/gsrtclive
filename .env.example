# Base URL of the upstream tracking API (no trailing slash). Required.
#
# Currently: the third-party tracker proxy (see docs/tracker-proxy-api.md). It is a
# small single-developer service with no SLA and it blocks clients that hammer it,
# so keep the rate below low. Target: the official infinium upstream, once its
# paths are mapped in server/routes.js.
UPSTREAM_BASE=https://tracker.shivrajsinh.in
# Optional value sent as x-device-id to the upstream.
UPSTREAM_DEVICE_ID=
# Outbound budget to the upstream: sustained requests/second and burst size.
# Kept low on purpose for the third-party upstream; raise only for an upstream you own.
UPSTREAM_RPS=1
UPSTREAM_BURST=2
# Per-client (IP) inbound limit: requests per minute.
CLIENT_RPM=60
PORT=8080

# ---- 24x7 route collector (Bhuj <-> Mundra) ----
# OFF by default. It polls every bus on the route around the clock, so only turn it
# on against an upstream you own, or with the operator's permission. The third-party
# proxy above registers every polled plate on its own watch list (max 60) and polls
# GSRTC for it, so ~25 plates around the clock is a real load on someone else's server.
COLLECTOR=off
# Route end points (station ids, names and coordinates). Defaults: Bhuj and Mundra.
#ROUTE_A_ID=594
#ROUTE_A_NAME=Bhuj
#ROUTE_A_LAT=23.25017
#ROUTE_A_LNG=69.6707
#ROUTE_B_ID=1082
#ROUTE_B_NAME=Mundra
#ROUTE_B_LAT=22.83904
#ROUTE_B_LNG=69.72438
# How often a moving bus / a stopped bus is polled.
POLL_ACTIVE_MS=30000
POLL_IDLE_MS=300000
# How often the timetable (bus roster) is refreshed, and the roster size cap.
ROSTER_REFRESH_MS=1800000
MAX_PLATES=30
# Buses within this distance of the straight Bhuj-Mundra line count as "on the route".
CORRIDOR_KM=20
# Position history (one JSONL file per IST day) and how long to keep it.
DATA_DIR=data
RETENTION_DAYS=30
