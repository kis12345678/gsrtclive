# Base URL of the upstream tracking API (no trailing slash). Required.
#
# Currently: the third-party tracker proxy (see docs/tracker-proxy-api.md). It is a
# small single-developer service with no SLA and it blocks clients that hammer it,
# so keep the rate below low. Target: the official infinium upstream, once its
# paths are mapped in server/routes.js.
UPSTREAM_BASE=https://tracker.shivrajsinh.in
# Optional value sent as x-device-id to the upstream.
UPSTREAM_DEVICE_ID=
# Outbound budget to the upstream: sustained requests/second and burst size.
# Kept low on purpose for the third-party upstream; raise only for an upstream you own.
UPSTREAM_RPS=1
UPSTREAM_BURST=2
# Per-client (IP) inbound limit: requests per minute.
CLIENT_RPM=60
PORT=8080
# Set to on ONLY when running behind a reverse proxy / Cloudflare Tunnel, so each real
# visitor gets their own CLIENT_RPM bucket. Leave off when the server is exposed directly
# (the forwarding headers are client-controlled and could be forged to dodge the limit).
TRUST_PROXY=off

# ---- 24x7 route collector (Bhuj <-> Mundra) ----
# OFF by default. It polls every bus on the route around the clock, so only turn it
# on against an upstream you own, or with the operator's permission. The third-party
# proxy above registers every polled plate on its own watch list (max 60) and polls
# GSRTC for it, so ~25 plates around the clock is a real load on someone else's server.
COLLECTOR=off
# Buses to track, comma separated (any format: GJ-18-Z-3021, gj18z3021, ...). Only these
# are polled and the timetable is not queried at all, so the load on the upstream is
# exactly (number of buses) x (poll rate). Below: the 14 buses that ran Bhuj <-> Mundra on
# at least 6 of 7 days in the timetable (29 Sep - 5 Oct 2026). Add or remove plates freely
# (fewer plates = less load), then restart. Leave empty to follow the whole timetable.
TRACK_PLATES=GJ18Z3021,GJ18Z3391,GJ18Z4810,GJ18Z6630,GJ18ZT2141,GJ18Z3628,GJ18Z4822,GJ18Z7909,GJ18Z8160,GJ18ZT0278,GJ18ZT1238,GJ18ZT3516,GJ18ZT3621,GJ18ZT4389
# Route end points (station ids, names and coordinates). Defaults: Bhuj and Mundra.
#ROUTE_A_ID=594
#ROUTE_A_NAME=Bhuj
#ROUTE_A_LAT=23.25017
#ROUTE_A_LNG=69.6707
#ROUTE_B_ID=1082
#ROUTE_B_NAME=Mundra
#ROUTE_B_LAT=22.83904
#ROUTE_B_LNG=69.72438
# Active hours, IST, comma separated HH:MM-HH:MM (a range like 22:00-02:00 wraps past
# midnight). OUTSIDE these hours nothing at all is sent to the upstream. Below: morning
# 06:00-10:30 and evening 16:00-20:30, which cover the Bhuj departures 06:14-10:14 and
# the Mundra departures 16:00-20:00 (a trip takes about 1.5 h, so the last buses of a
# window finish a little after it closes: widen it if you want them to the end).
# Leave empty to track around the clock.
ACTIVE_WINDOWS=06:00-10:30,16:00-20:30
# How often a moving bus / a stopped bus is polled (ms). 2 minutes while moving.
POLL_ACTIVE_MS=120000
POLL_IDLE_MS=300000
# How often the timetable roster is refreshed (ignored when TRACK_PLATES is set), and the size cap.
ROSTER_REFRESH_MS=1800000
MAX_PLATES=30
# Buses within this distance of the straight Bhuj-Mundra line count as "on the route".
CORRIDOR_KM=20
# Position history (one JSONL file per IST day) and how long to keep it.
DATA_DIR=data
RETENTION_DAYS=30
